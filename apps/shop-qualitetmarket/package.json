{
  "name": "shop-qualitetmarket",
  "version": "0.1.0",
  "private": true,
  "description": "Shop Qualitet Marketplace store model and MongoDB repository",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:server && next build",
    "build:server": "tsc -p tsconfig.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.next.json && tsc --noEmit -p tsconfig.json",
    "auth:hash-password": "node scripts/generate-shop-password-hash.mjs"
  },
  "dependencies": {
    "mongodb": "^6.21.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
